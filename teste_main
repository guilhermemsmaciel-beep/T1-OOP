#include <iostream>
#include <string>
#include <unistd.h>
#include <cstdlib>

#include "jogador.h"
#include "mapa.h"

int main() {
    
    Mapa mapa;
    Jogador jogador;
    jogador.setVida(1);
    jogador.setPosicao({4, 4});
    
    
    mapa.printMapa(jogador);
    
    while(jogador.isAlive()) {
        system("stty raw");
        char comando = std::getchar();
        system("stty cooked");
        std::cout << "\n";
        jogador.atualizarPos(comando);
        mapa.printMapa(jogador);
    }

    
    
    
    
    return 0;
}
